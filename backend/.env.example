MONGO_URI=
PORT=5001
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
JWT_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Required at startup
OTP_SECRET=
CLIENT_URL=http://localhost:3001
# On Vercel: set CLIENT_URL to the frontend URL(s), comma-separated, e.g. https://hair2harvest.vercel.app
# and COOKIE_SAMESITE=none when the frontend and API are on different domains.
COOKIE_SAMESITE=lax
NODE_ENV=development

# Vercel Blob (private consent PDFs). Added automatically when you connect a Blob store in Vercel.
# Leave empty locally to store files under ./uploads instead.
BLOB_READ_WRITE_TOKEN=
