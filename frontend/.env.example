# Backend API base URL (include /api).
# Local: http://localhost:5001/api
# On Vercel: set VITE_API_URL=/api. frontend/vercel.json proxies /api/* to the backend, so the
# session cookie is first-party (cross-domain cookies are blocked on iOS Safari and many browsers).
# Redeploy after changing it (Vite bakes it in at build time).
VITE_API_URL=http://localhost:5001/api
