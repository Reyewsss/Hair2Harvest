# Backend API base URL (include /api). Optional:
# - `npm run dev` defaults to http://localhost:5001/api
# - production builds default to /api, which frontend/vercel.json proxies to the backend so the
#   session cookie is first-party (cross-domain cookies are blocked on iOS Safari and many browsers).
# Set it only to override those defaults. Nothing needs to be set on Vercel.
VITE_API_URL=http://localhost:5001/api
